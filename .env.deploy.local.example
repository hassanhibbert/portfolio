# Copy this file to .env.deploy.local and fill in your DreamHost details.
# .env.deploy.local is gitignored, so real values never get committed.
# Anything you've already exported in your shell takes priority over this file.
# Login uses your SSH key (set it up once with ssh-copy-id); no passwords here.

# Your DreamHost shell username (Panel > Users > Manage Users).
DEPLOY_USER=

# The SSH host for that user. Your domain often works; otherwise use the
# hostname shown on the Manage Users page (looks like <server>.dreamhost.com).
DEPLOY_HOST=

# The folder DreamHost serves for hassanhibbert.com (Panel > Domains >
# Manage Domains shows the web directory). Must be this site's own folder:
# deploys delete anything in it that isn't part of the build.
DEPLOY_PATH=
